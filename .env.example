JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
DATABASE_URL=postgresql+psycopg://taskflow:taskflow_dev_password@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379/0
TASKFLOW_ENV=development
API_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=3
REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
REFRESH_RATE_LIMIT_MAX_ATTEMPTS=20
REFRESH_RATE_LIMIT_WINDOW_SECONDS=300
WEBSOCKET_RATE_LIMIT_MAX_ATTEMPTS=30
WEBSOCKET_RATE_LIMIT_WINDOW_SECONDS=60
WEBSOCKET_TICKET_TTL_SECONDS=60
STALE_JOB_TIMEOUT_MINUTES=120

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Background jobs (optional - default to REDIS_URL above when unset)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
OVERDUE_SCAN_INTERVAL_MINUTES=15
DUE_SOON_REMINDER_INTERVAL_MINUTES=30
DUE_SOON_WINDOW_HOURS=24
DIGEST_INTERVAL_HOURS=24
SESSION_CLEANUP_INTERVAL_HOURS=6
REFRESH_TOKEN_RETENTION_DAYS=30
